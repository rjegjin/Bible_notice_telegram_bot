# 보안 파일 (절대 업로드 금지)
.env

# 파이썬 가상환경 및 컴파일 파일
venv/
__pycache__/
*.pyc

# OS 시스템 파일
.DS_Store
Thumbs.db
*.ps1

# (선택) 로그 파일이나 임시 파일이 있다면 추가
*.log

# assets 폴더 내 이미지는 추적 허용
!assets/*.png
!assets/*.jpg
!assets/*.jpeg
!assets/*.webp
data/plans/backups/
data/plans/standby/
# 개인 기도문·원본 이미지·발송 marker는 운영 데이터이며 Git에 올리지 않는다.
data/prayers/
